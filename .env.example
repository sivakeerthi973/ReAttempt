# Copy this file to .env and replace the placeholders before running.
SECRET_KEY=replace_with_a_unique_random_secret
DATABASE_URL=mysql+pymysql://reattempt_user:replace_this_password@127.0.0.1:3306/reattempt_db?charset=utf8mb4
FLASK_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_HOURS=2
FLASK_DEBUG=false
